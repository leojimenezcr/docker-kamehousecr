# Variables esperadas por stacks/n8n/docker-compose.yml
# Cargar los valores reales en Portainer > Stack "n8n" > Environment variables.
# NUNCA completar este archivo con valores reales ni versionarlo en git con datos sensibles.

BASE_DIR=/ruta/al/volumen/de/n8n

# Clave de cifrado de credenciales de n8n. Generarla una sola vez (ej.
# `openssl rand -hex 32`) y NUNCA cambiarla despues de tener workflows con
# credenciales guardadas — perderla o cambiarla vuelve irrecuperables las
# credenciales ya guardadas en n8n.
N8N_ENCRYPTION_KEY=generar_con_openssl_rand_hex_32

# Secretos del sandbox de ejecucion de codigo del AI Assistant. Valores
# propios (no dejar como "change-me-..."). SANDBOX_API_KEYS y
# N8N_INSTANCE_AI_SANDBOX_API_KEY deben cargarse con el MISMO valor: es
# como n8n se autentica contra el sandbox.
SANDBOX_API_KEYS=valor_propio_no_change_me
N8N_INSTANCE_AI_SANDBOX_API_KEY=mismo_valor_que_sandbox_api_keys
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=valor_propio_no_change_me
SANDBOX_API_RUNNER_API_KEY=valor_propio_no_change_me

# Secreto del SearXNG embebido (busqueda web del AI Assistant).
SEARXNG_SECRET=valor_propio_no_change_me

# Modelo a usar contra el stack `ollama` (AI Assistant). Debe coincidir
# EXACTO con el modelo ya descargado ahi (`ollama pull`) — ver
# ../ollama/.env.example y ../ollama/README.md.
OLLAMA_MODEL=qwen2.5:7b-instruct
